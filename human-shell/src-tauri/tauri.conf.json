{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "human-shell",
  "version": "0.0.0",
  "identifier": "space.phase.graph-workflow.human-shell",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "graph-workflow — human input",
        "width": 780,
        "height": 680,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
